{
  "name": "prepforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PrepForge: an adaptive placement-preparation platform for fresher SDE roles at big product companies.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:problems": "node scripts/build-problem-bank.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify:code": "vite-node scripts/verify-code.ts"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sql.js": "^1.14.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
